# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Этап 1: Сборка приложения (Builder stage)
# Используем легковесный официальный образ Golang на базе Alpine Linux
# ------------------------------------------------------------------------------
FROM golang:1.22-alpine AS builder

# Задаем рабочую директорию внутри сборочного контейнера
WORKDIR /build

# Устанавливаем минимальные системные утилиты:
# git — для загрузки внешних Go-модулей
# ca-certificates — для валидации SSL-сертификатов при обращении к HTTPS-репозиториям
RUN apk add --no-cache git ca-certificates

# Оптимизация кэширования слоев Docker:
# Копируем файлы описания зависимостей (go.mod и go.sum)
COPY go.mod go.sum ./
# Скачиваем внешние зависимости в отдельный кэшируемый слой
RUN go mod download

# Копируем весь остальной исходный код проекта
COPY . .

# Компиляция статического исполняемого файла:
# CGO_ENABLED=0            — отключение Си-зависимостей (libc) для 100% автономности бинарника
# GOOS=linux GOARCH=amd64  — сборка под целевую архитектуру Linux AMD64
# -ldflags="-s -w"         — удаление таблицы символов и отладочной информации DWARF
# -extldflags '-static'    — статическая компоновка внешних библиотек
# -o /app/memcache         — путь сохранения скомпилированного бинарника
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -extldflags '-static'" \
    -o /app/memcache ./lynks/memcache/cmd/server

# ------------------------------------------------------------------------------
# Этап 2: Финальный минимальный runtime-образ (Production stage)
# В продакшен идет только чистый Alpine без компилятора Go и исходников (~15 МБ)
# ------------------------------------------------------------------------------
FROM alpine:3.19

# Устанавливаем ca-certificates (HTTPS), tzdata (часовые пояса) и wget (для healthcheck)
RUN apk --no-cache add ca-certificates tzdata wget

# Задаем рабочую директорию финального контейнера
WORKDIR /app

# Безопасность: создаем системного непривилегированного пользователя appuser (UID 1000)
RUN adduser -D -u 1000 appuser
# Переключаемся на непривилегированного пользователя (отказ от root-прав)
USER appuser

# Копируем только скомпилированный бинарник с этапа сборки builder
COPY --from=builder /app/memcache /app/memcache

# Декларируем сетевой порт сервиса кэширования
EXPOSE 8082

# Точка входа: команда запуска сервиса memcache в Exec-форме (получает PID 1)
ENTRYPOINT ["/app/memcache"]
