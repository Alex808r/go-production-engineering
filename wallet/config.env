# Application settings
APP_PORT=8080
APP_ENV=production

# ==============================================================================
# Database settings
# ==============================================================================
# 💡 ВАЖНО: Разница между запуском в Docker и нативным запуском на компьютере:
# 
# 1. Если Go-сервис крутится ВНУТРИ DOCKER (docker compose up):
#    DB_HOST=postgres
#    (контейнер приложения обращается к контейнеру базы по имени его сервиса в сети Docker)
#
# 2. Если Go-сервис запущен НАПРЯМУЮ НА ВАШЕМ КОМПЬЮТЕРЕ (go run ./cmd/app или IDE Debug):
#    DB_HOST=localhost
#    (приложение стучится в порт 5432 на localhost, проброшенный из Docker-контейнера базы)
#    Или можно запустить одной командой: DB_HOST=localhost go run ./cmd/app
# ==============================================================================
DB_HOST=postgres
# DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet_user
DB_PASSWORD=wallet_password
DB_NAME=wallet_db
DB_SSLMODE=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=20
DB_MAX_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=1h

# HTTP Server settings
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
