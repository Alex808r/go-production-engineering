# Application settings
APP_PORT=8080
APP_ENV=production

# Database settings
DB_HOST=postgres
DB_PORT=5432
DB_USER=wallet_user
DB_PASSWORD=wallet_password
DB_NAME=wallet_db
DB_SSLMODE=disable
DB_MAX_CONNS=100
DB_MIN_CONNS=20
DB_MAX_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=1h

# HTTP Server settings
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
