# ==============================================================================
# Этап 1: Сборка приложения (Builder stage)
# Используем полный образ Go на базе легковесного Alpine Linux
# ==============================================================================
FROM golang:1.24-alpine AS builder

# Задаем рабочую директорию внутри контейнера сборщика
WORKDIR /app

# Устанавливаем минимальные системные утилиты:
# git — для загрузки внешних Go-модулей
# ca-certificates — для безопасных HTTPS-запросов к репозиториям
RUN apk add --no-cache git ca-certificates

# ------------------------------------------------------------------------------
# Оптимизация кэширования слоев Docker:
# Сначала копируем только файлы описания зависимостей.
# Если файлы go.mod и go.sum не менялись, Docker возьмет скачанные зависимости из кэша,
# даже если изменился исходный код приложения (.go файлы).
# ------------------------------------------------------------------------------
COPY go.mod go.sum ./
RUN go mod download

# Копируем остальной исходный код проекта
COPY . .

# ------------------------------------------------------------------------------
# Компиляция исполняемого бинарного файла:
# CGO_ENABLED=0 — отключает динамическое связывание с системной библиотекой C (libc).
#                Бинарник получается 100% статическим и автономным.
# GOOS=linux    — целевая операционная система Linux.
# -ldflags:
#   -s          — удаляет таблицу символов (symbol table).
#   -w          — удаляет отладочную информацию DWARF.
#   В сумме эти флаги уменьшают размер бинарника более чем в 2 раза.
# -o /bin/wallet-app — путь для сохранения скомпилированного файла.
# ------------------------------------------------------------------------------
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/wallet-app ./cmd/app

# ==============================================================================
# Этап 2: Финальный продакшен-образ (Minimal Runtime stage)
# В прод идет только чистый Alpine без Go SDK, компиляторов и исходников.
# Размер итогового образа составляет всего ~15 МБ вместо сотен мегабайт.
# ==============================================================================
FROM alpine:3.20

WORKDIR /app

# Устанавливаем корневые сертификаты и данные о часовых поясах
RUN apk add --no-cache ca-certificates tzdata

# ------------------------------------------------------------------------------
# Безопасность (Non-root user):
# Запуск приложений от пользователя root в контейнерах — серьезная уязвимость.
# Создаем системную группу и пользователя appuser с ограниченными правами.
# ------------------------------------------------------------------------------
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Копируем только скомпилированный бинарник с этапа сборки
COPY --from=builder /bin/wallet-app /app/wallet-app

# Копируем конфигурационный файл окружения и SQL-миграции
COPY config.env /app/config.env
COPY migrations /app/migrations

# Переключаемся на непривилегированного пользователя
USER appuser

# Декларируем порт, на котором слушает наш HTTP-сервер
EXPOSE 8080

# ------------------------------------------------------------------------------
# Проверка здоровья контейнера (Healthcheck):
# Docker периодически опрашивает эндпоинт /health.
# interval=5s     — проверять каждые 5 секунд.
# timeout=3s      — таймаут ответа 3 секунды.
# retries=5       — считать контейнер больным (unhealthy) после 5 неудач подряд.
# start-period=5s — льготный период на запуск сервиса перед началом проверок.
# ------------------------------------------------------------------------------
HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=5s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Точка входа: команда запуска сервиса при старте контейнера
ENTRYPOINT ["/app/wallet-app"]
