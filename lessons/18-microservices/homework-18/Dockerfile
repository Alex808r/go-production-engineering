# syntax=docker/dockerfile:1
# ==============================================================================
# Этап 1: Сборка статического бинарного файла (Builder stage)
# Используем официальный образ Go на базе Alpine Linux
# ==============================================================================
FROM golang:1.22-alpine AS builder

# Рабочая директория внутри контейнера сборщика
WORKDIR /build

# Установка системных утилит: git (для скачивания модулей) и сертификатов
RUN apk add --no-cache git ca-certificates

# Оптимизация кэширования: сначала копируем манифесты зависимостей
COPY go.mod go.sum ./
# Скачиваем внешние зависимости (кэшируется, если go.mod/go.sum не менялись)
RUN go mod download

# Копируем весь исходный код репозитория
COPY . .

# Переходим в директорию команды микросервиса shortener
WORKDIR /build/homework-18/cmd/shortener

# Компиляция статического бинарника без CGO:
# CGO_ENABLED=0            — отключение динамической линковки с C-библиотеками (libc)
# GOOS=linux GOARCH=amd64  — целевая ОС Linux 64-bit
# -ldflags="-s -w"         — вырезание таблицы символов и отладочных метаданных
# -extldflags '-static'    — статическая компоновка
# -o /app/shortener .      — выходной бинарный файл
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -extldflags '-static'" \
    -o /app/shortener .

# ==============================================================================
# Этап 2: Финальный минимальный production-образ
# Легковесный дистрибутив Alpine Linux без сборочных инструментов (~15 МБ)
# ==============================================================================
FROM alpine:3.19

# Установка корневых SSL-сертификатов (для исходящих HTTPS) и часовых поясов
RUN apk --no-cache add ca-certificates tzdata

# Рабочая папка для запуска сервиса
WORKDIR /app

# Создаем системного непривилегированного пользователя appuser (UID 1000) для безопасности
RUN adduser -D -u 1000 appuser
# Переключаем контекст выполнения на непривилегированного пользователя (отказ от root)
USER appuser

# Копируем только скомпилированный бинарный файл с этапа сборки builder
COPY --from=builder /app/shortener /app/shortener

# Переменные окружения по умолчанию (могут переопределяться в docker-compose.yml)
ENV PORT=8080
ENV BASE_URL=http://localhost:8080

# Декларируем рабочий порт микросервиса
EXPOSE 8080

# Точка входа: запуск бинарника в Exec-форме (бинарник получает PID 1 и ловит SIGTERM)
ENTRYPOINT ["/app/shortener"]
