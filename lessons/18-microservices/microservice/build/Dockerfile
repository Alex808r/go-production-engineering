# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Базовый образ: официальный образ Go версии 1.21
# ------------------------------------------------------------------------------
FROM golang:1.21

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем исходные файлы проекта в контейнер
COPY . .
# Скачиваем внешние зависимости модулей Go
RUN go mod download

# Переходим в директорию точки входа приложения (main package)
WORKDIR /app/cmd/app
# Компилируем исполняемый файл под операционную систему Linux
RUN GOOS=linux go build -o app

# Декларируем порт, на котором слушает веб-сервер приложения
EXPOSE 8080

# Команда по умолчанию при старте контейнера (Exec Form)
CMD ["./app"]

# ------------------------------------------------------------------------------
# Примеры запуска из командной строки терминала:
# Сборка образа с указанием пути к Dockerfile:
# docker build -f ./build/Dockerfile --progress=plain -t dmitriytitov/microapp:latest .
# Запуск контейнера с пробросом порта 8080 и удалением после остановки (--rm):
# docker run --rm -p 8080:8080 dmitriytitov/microapp:latest
# ------------------------------------------------------------------------------