# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Этап 1: Сборка приложения (Builder stage)
# Используем легковесный образ Golang на базе Alpine Linux
# ------------------------------------------------------------------------------
FROM golang:1.22-alpine AS builder

# Задаем рабочую директорию сборщика
WORKDIR /build

# Устанавливаем git и сертификаты для скачивания зависимостей
RUN apk add --no-cache git ca-certificates

# Оптимизация кэша слоев: копируем файлы описания модулей
COPY go.mod go.sum ./
# Скачиваем внешние зависимости в отдельный кэшируемый слой
RUN go mod download

# Копируем весь остальной исходный код проекта
COPY . .

# Компиляция статического исполняемого файла сервиса memcache:
# CGO_ENABLED=0            — автономный бинарник без CGO
# GOOS=linux GOARCH=amd64  — сборка под Linux AMD64
# -ldflags="-s -w"         — стриппинг таблицы символов и DWARF-отладки
# -extldflags '-static'    — статическая компоновка библиотек
# -o /app/memcache         — путь сохранения бинарника
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -extldflags '-static'" \
    -o /app/memcache ./homework-20/memcache/cmd

# ------------------------------------------------------------------------------
# Этап 2: Финальный минимальный runtime-образ (Production stage)
# Чистый Alpine Linux без Go SDK (~15 МБ)
# ------------------------------------------------------------------------------
FROM alpine:3.19

# Устанавливаем ca-certificates (HTTPS), tzdata (таймзоны) и wget (для healthcheck)
RUN apk --no-cache add ca-certificates tzdata wget

# Рабочая папка сервиса
WORKDIR /app

# Безопасность: создаем системного пользователя appuser (UID 1000)
RUN adduser -D -u 1000 appuser
# Переключаем выполнение на непривилегированного пользователя (отказ от root)
USER appuser

# Копируем только скомпилированный бинарник с этапа сборщика builder
COPY --from=builder /app/memcache /app/memcache

# Декларируем сетевой порт сервиса кэширования
EXPOSE 8082

# Точка входа: запуск сервиса memcache в Exec-форме
ENTRYPOINT ["/app/memcache"]
